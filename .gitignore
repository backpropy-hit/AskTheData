# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Databases (built locally from CSVs, never committed) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Raw data: kept out until the licence check allows redistribution ---
data/raw/*
!data/raw/.gitkeep

# --- LLM response cache (may contain prompts and model output) ---
.cache/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Streamlit local secrets ---
.streamlit/secrets.toml
